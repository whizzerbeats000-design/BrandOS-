export const NEW_DROP_PRODUCTS: readonly Product[] = [
  PRODUCTS.find((p) => p.slug === "sand-trench-coat")!,
  PRODUCTS.find((p) => p.slug === "graphite-long-sleeve-tee")!,
  PRODUCTS.find((p) => p.slug === "olive-crew-tee")!,
];

export const CURATED_PRODUCTS: readonly Product[] = [
  PRODUCTS.find((p) => p.slug === "noir-crew-tee")!,
  PRODUCTS.find((p) => p.slug === "noir-zip-hoodie")!,
  PRODUCTS.find((p) => p.slug === "clay-leather-belt")!,
  PRODUCTS.find((p) => p.slug === "espresso-trench-coat")!,
];

export const SIGNATURE_PRODUCTS: readonly Product[] = PRODUCTS.filter(
  (p) => p.category === "outerwear" || p.collection === "signature",
).slice(0, 3);

export interface ProductSummary {
  slug: string;
  name: string;
  price: number;
  currency?: string;
  image: ProductImage;
  aspectRatio?: AspectRatio;
}

/** Compact per-slug map for client-light features (e.g. recently viewed). */
export const PRODUCT_SUMMARIES: Record<string, ProductSummary> = Object.fromEntries(
  PRODUCTS.map((p) => [
    p.slug,
    {
      slug: p.slug,
      name: p.name,
      price: p.price,
      currency: p.currency,
      image: p.images[0],
      aspectRatio: p.aspectRatio,
    },
  ]),
);

/**
 * Related products for the given product: same category first (excluding the
 * product itself), then same collection, capped at `limit`.
 */
export function getRelatedProducts(product: Product, limit = 4): Product[] {
  const sameCategory = PRODUCTS.filter(
    (p) => p.slug !== product.slug && p.category === product.category,
  );
  const sameCollection = PRODUCTS.filter(
    (p) =>
      p.slug !== product.slug &&
      p.collection === product.collection &&
      p.category !== product.category,
  );
  return [...sameCategory, ...sameCollection].slice(0, limit);
}
