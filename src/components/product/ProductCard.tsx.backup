import React from "react";
import NextImage from "next/image";
import Link from "next/link";
import { cn } from "@/lib/cn";
import { formatPrice } from "@/lib/format";
import { getColorOption } from "@/data/catalogue";
import { buildProductEnquiryUrl } from "@/lib/integrations";
import { DepthCard } from "@/components/ui/DepthCard";
import type { AspectRatio, Product } from "@/types";
import { useReducedMotion } from "@/hooks/useReducedMotion";

const ASPECT_CLASSES: Record<AspectRatio, string> = {
  "1/1": "aspect-square",
  "3/4": "aspect-[3/4]",
  "4/5": "aspect-[4/5]",
  "4/3": "aspect-[4/3]",
  "16/9": "aspect-video",
  "9/16": "aspect-[9/16]",
  "21/9": "aspect-[21/9]",
};

interface ProductCardProps {
  product: Product;
  /** Responsive sizes hint for `next/image`. */
  sizes?: string;
  priority?: boolean;
  className?: string;
  /** Editorial framing override. The catalogue grid normalises to one ratio
   *  so rows stay aligned; the detail page uses the product's own framing. */
  aspectRatio?: AspectRatio;
}

function getPointerRatio(e: React.MouseEvent, containerRef: React.RefObject<HTMLDivElement>) {
  if (!containerRef.current) return { x: 0, y: 0 };
  const rect = containerRef.current.getBoundingClientRect();
  const x = (e.clientX - rect.left) / rect.width - 0.5;
  const y = (e.clientY - rect.top) / rect.height - 0.5;
  return { x, y };
}

export function ProductCard({
  product,
  sizes = "100vw",
  priority = false,
  className,
  aspectRatio,
}: ProductCardProps) {
  const reduced = useReducedMotion();
  const href = `/product/${product.slug}`;
  const soldOut = product.availability === "sold-out";
  const lowStock = product.availability === "low-stock";
  const aspect = aspectRatio ?? product.aspectRatio ?? "4/5";
  const gender = product.gender ?? "unisex";
  const thumbnail = product.images[0];
  const hoverView = product.images[1];
  const enquiry = buildProductEnquiryUrl(product.name);

  const meta = [product.category, gender].filter(Boolean).join(" · ");

  const [bagState, setBagState] = React.useState<'idle' | 'adding' | 'added'>('idle');

  const containerRef = React.useRef<HTMLDivElement>(null);
  const imgRef = React.useRef<HTMLElement>(null);

  const handleMouseMove = React.useCallback(
    (e: React.MouseEvent) => {
      if (reduced) return;
      if (!containerRef.current) return;
      const { x, y } = getPointerRatio(e, containerRef);
      
      // Tilt effect on the DepthCard container
      containerRef.current.style.setProperty("--ry", `${x * 2}deg`);
      containerRef.current.style.setProperty("--rx", `${-y * 2}deg`);
      
      // Specular highlight move
      if (imgRef.current) {
        const imgRect = imgRef.current.getBoundingClientRect();
        const hoverX = e.clientX - imgRect.left;
        const hoverY = e.clientY - imgRect.top;
        imgRef.current.style.setProperty("--sh-x", `${hoverX}px`);
        imgRef.current.style.setProperty("--sh-y", `${hoverY}px`);
      }
      
      // Zoom effect on the thumbnail
      if (imgRef.current) {
        const scale = 1 + Math.abs(x) * 0.1 + Math.abs(y) * 0.1;
        imgRef.current.style.transform = `scale(${scale})`;
      }
    },
    [reduced]
  );

  const handleMouseLeave = React.useCallback(() => {
    if (reduced) return;
    if (containerRef.current) {
      containerRef.current.style.setProperty("--ry", `0deg`);
      containerRef.current.style.setProperty("--rx", `0deg`);
    }
    if (imgRef.current) {
      imgRef.current.style.transform = "scale(1)";
      imgRef.current.style.setProperty("--sh-x", "0px");
      imgRef.current.style.setProperty("--sh-y", "0px");
    }
  }, [reduced]);

  const [isHovering, setIsHovering] = React.useState(false);


  const handleAddToBag = React.useCallback(async () => {
    if (bagState === "adding" || bagState === "added") return;
    setBagState("adding");
    
    // Simulate the add-to-bag operation
    await new Promise(resolve => setTimeout(resolve, 800));
    
    setBagState("added");
    
    // Reset after 2 seconds
    const timer = setTimeout(() => setBagState("idle"), 2000);
    return () => clearTimeout(timer);
  }, []);

  React.useEffect(() => {
    // Initialize the specular CSS variables on mount
    const style = document.createElement("style");
    style.textContent =
      `.product-card--specular { \n` +
      `  --sh-x: 0px; \n` +
      `  --sh-y: 0px; \n` +
      `  transition: var(--duration-standard) ease-standard; \n      }`;
    document.head.appendChild(style);
    return () => document.head.removeChild(style);
  }, []);

  React.useEffect(() => {
    // Add on-hover style tag for specular
    const specularStyle = document.createElement("style");
    specularStyle.textContent = `
      .product-card--hovering {
        --sh-x: 0px;\n        --sh-y: 0px;\n        transition: var(--duration-standard) ease-standard;\n      }\n      .product-card--hovering .product-card__thumb {
        transition: transform var(--duration-slow) var(--ease-cinematic);\n      }\n    `;
    document.head.appendChild(specularStyle);
    return () => document.head.removeChild(specularStyle);
  }, []);

  React.useEffect(() => {
    const onEnter = () => setIsHovering(true);
    const onLeave = () => {
      setIsHovering(false);
      if (containerRef.current) {
        containerRef.current.style.setProperty("--ry", `0deg`);
        containerRef.current.style.setProperty("--rx", `0deg`);
      }
    };
    if (containerRef.current) {
      containerRef.current.addEventListener("mouseenter", onEnter);
      containerRef.current.addEventListener("mouseleave", onLeave);
    }
    return () => {
      if (containerRef.current) {
        containerRef.current.removeEventListener("mouseenter", onEnter);
        containerRef.current.removeEventListener("mouseleave", onLeave);
      }
    };
  }, []);

  return (
    <DepthCard
      className={cn(
        "product-card group flex flex-col overflow-hidden bg-surface",
        reduced && "reduce-motion",
        isHovering && "product-card--hovering",
        className
      )}
      ref={containerRef}
    >
      <Link
        href={href}
        className="relative block overflow-hidden"
        aria-label={`${product.name}, ${meta}`}
      >
        <div className={cn("relative w-full", ASPECT_CLASSES[aspect])}>
          <NextImage
            ref={imgRef}
            src={thumbnail.src}
            alt={thumbnail.alt}
            fill
            sizes={sizes}
            preload={priority}
            className={cn(
              "product-card__thumb object-cover transition-transform duration-slow ease-cinematic"
              , reduced && "reduce-motion"
            )}
          />
          {hoverView ? (
            <NextImage
              src={hoverView.src}
              alt={hoverView.alt}
              fill
              sizes={sizes}
              preload={priority}
              className={cn(
                "product-card__hover absolute inset-0 object-cover opacity-0 transition-opacity duration-standard ease-standard group-hover:opacity-100 motion-reduce:opacity-0",
                "product-card__hover--zoom" + (isHovering ? " opacity-100" : "")
              )}
            />
          ) : null}
        </div>

        {/* Specular highlight overlay */}
        <span
          className="absolute inset-0 product-card--specular opacity-5"
          style={{ background: "radial-gradient(var(--sh-x) var(--sh-y), from(#c2a878) 0%, transparent 50%)" }}
        />

        {product.badge ? (
          <span className="type-metadata absolute left-4 top-4 bg-background/80 px-3 py-1.5 text-accent">
            {product.badge}
          </span>
        ) : null}
        {soldOut ? (
          <span className="type-metadata absolute right-4 top-4 bg-background/80 px-3 py-1.5 text-foreground-secondary">
            Sold out
          </span>
        ) : null}
      </Link>

      <div className="mt-4 flex flex-col gap-1">
        <p className="type-metadata text-foreground-muted">
          {meta}
          {lowStock ? <span className="text-accent"> · Only a few left</span> : null}
        </p>
        <Link href={href} className="group-hover:text-accent">
          <h3 className="type-body font-medium text-foreground transition-colors duration-standard ease-standard group-hover:text-accent">
            {product.name}
          </h3>
        </Link>
        {product.colors.length > 1 ? (
          <ul className="mt-2 flex items-center gap-1.5" aria-label={`${product.colors.length} colours`}>
            {product.colors.map((colorId) => (
              <li
                key={colorId}
                title={getColorOption(colorId).name}
                className="h-3 w-3 rounded-full border border-border-strong"
                style={{ backgroundColor: getColorOption(colorId).hex }}
              />
            ))}
          </ul>
        ) : null}

        <div className="mt-3 flex items-center justify-between gap-4">
          <p className="type-price text-foreground-secondary">{formatPrice(product.price, product.currency)}</p>
          {!soldOut && (
            <button
              type="button"
              className={cn(
                "type-button add-to-bag-btn inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium transition-colors ",
                bagState === "adding" && "bg-accent/90 text-accent-contrast animate-pulse",
                bagState === "added" && "bg-accent/90 text-accent-contrast"
              )}
              onClick={handleAddToBag}
              aria-label={
                bagState === "adding"
                  ? "Adding to bag..."
                  : bagState === "added"
                    ? "Added to bag"
                    : `Add ${product.name} to bag`
              }
            >
              {bagState === "idle" && (
                <span className="flex items-center gap-2">
                  Add to bag
                  <svg
                    className="h-4 w-4 text-accent"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth={2}
                    aria-hidden="true"
                  >
                    <rect x="3" y="3" width="7" height="19" />
                    <rect x="14" y="3" width="7" height="19" />
                    <rect x="3" y="14" width="7" height="7" />
                    <rect x="14" y="14" width="7" height="7" />
                  </svg>
                </span>
              )}
              {bagState === "adding" && (
                <span className="flex items-center gap-2">
                  Adding…
                  <svg
                    className="h-4 w-4 animate-spin text-accent"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth={2}
                    aria-hidden="true"
                  >
                    <circle
                      cx="12"
                      cy="12"
                      r="10"
                      opacity="0.25"
                    />
                    <path
                      cx="12"
                      cy="12"
                      r="10"
                      fill="currentColor"
                      d="M7.62 2.5a5.98 5.98 0 0 1 3.395 6.425L21.05 21.05a5.98 5.98 0 0 1-8.66 8.66L7.62 2.5z"
                    />
                  </svg>
                </span>
              )}
              {bagState === "added" && (
                <span className="flex items-center gap-2">
                  Added ✓
                  <svg
                    className="h-4 w-4 text-accent"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth={2}
                    aria-hidden="true"
                  >
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                    <path d="M22 4L3 14" />
                    <path d="L3 10h5a7 7 0 0 1 7 7z" />
                  </svg>
                </span>
              )}
            </button>
          )}
          {soldOut && (
            <a
              href={enquiry.href}
              className="link-underline type-nav text-foreground-muted transition-colors duration-standard ease-standard hover:text-accent"
            >
              Ask about this piece
            </a>
          )}
        </div>
      </div>
    </DepthCard>
  );
}
