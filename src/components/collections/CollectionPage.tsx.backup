import type { CSSProperties } from "react";
import { CollectionNav } from "@/components/collections/CollectionNav";
import { CollectionHero } from "@/components/collections/CollectionHero";
import { CollectionIntro } from "@/components/collections/CollectionIntro";
import { CollectionFeatured } from "@/components/collections/CollectionFeatured";
import { CollectionGallery } from "@/components/collections/CollectionGallery";
import { CollectionCatalogue } from "@/components/collections/CollectionCatalogue";
import { CollectionStory } from "@/components/collections/CollectionStory";
import { CollectionRelated } from "@/components/collections/CollectionRelated";
import type { CatalogueSearchParams } from "@/lib/catalogue";
import type { Collection } from "@/types";

interface CollectionPageProps {
  collection: Collection;
  /** Resolved catalogue state, lockable to this collection. */
  catalogueParams: CatalogueSearchParams;
}

export function CollectionPage({ collection, catalogueParams }: CollectionPageProps) {
  const themeVars = {
    "--collection-surface": collection.theme.surface,
    "--collection-accent": collection.theme.accent,
  } as CSSProperties;

  return (
    <div style={themeVars}>
      <CollectionNav activeSlug={collection.slug} accent={collection.theme.accent} />
      <CollectionHero collection={collection} />
      <CollectionIntro collection={collection} />
      <CollectionFeatured collection={collection} />
      <CollectionGallery
        images={collection.gallery}
        id={`${collection.slug}-gallery`}
        accent={collection.theme.accent}
      />
      <CollectionCatalogue collection={collection} params={catalogueParams} />
      <CollectionStory collection={collection} />
      <CollectionRelated collection={collection} />
    </div>
  );
}
