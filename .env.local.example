# AI image-generation provider configuration (server-side only)
# Copy to .env.local and fill in real values. Never commit .env.local.

# Provider selection: "gemini" (default) or "nvidia"
AI_IMAGE_PROVIDER=gemini

# Gemini (Google AI Studio key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_KEY_HERE

# NVIDIA image generation (build.nvidia.com key)
NVIDIA_API_KEY=
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev

# Shared secret required to call /api/ai/generate
AI_ADMIN_TOKEN=YOUR_ADMIN_TOKEN_HERE

# Image model (gemini provider): flash (default) or pro via the `model` request field
AI_MODEL=gemini-3.1-flash-image

# 1K (default) or 2K
AI_IMAGE_SIZE=1K
