# SUS WEARS — Environment Variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# Production URL (set in Vercel dashboard for production)
NEXT_PUBLIC_SITE_URL=https://sus-wears.vercel.app

# WhatsApp business number in E.164 format (optional — hardcoded fallback exists)
# NEXT_PUBLIC_WHATSAPP_NUMBER=2349070970886

# VERCEL_OIDC_TOKEN — injected by Vercel for OIDC-protected deployments.
# Not read by application code; do not hand-create locally.
# VERCEL_OIDC_TOKEN=
